# Turf and Landscaping — private invoice app (server-side only; never
# commit real values, never expose these to the browser)

# Supabase project (Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters; sessions are HMAC-signed with this
SESSION_SECRET=

# Comma-separated allowlist of admin sign-in emails
ADMIN_EMAILS=info@turfandlandscaping.com.au
