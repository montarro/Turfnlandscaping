// Cloudflare Workers static-assets deploy of the prebuilt site (dist/).
// SUPERSEDED at go-live (30 Aug 2026): the site now serves from Vercel on
// bastianolandscaping.com.au, and nothing points at this worker. Kept only
// as a spare static copy; the /api functions are Vercel-only, so /admin
// never worked here. Deploy: npm run build && npx wrangler deploy
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "bastiano-landscaping",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
