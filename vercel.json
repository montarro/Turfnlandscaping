{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-site.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "^app\\.bastianolandscaping\\.com\\.au$" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/review(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/natural-turf-solutions",
      "destination": "/services/natural-turf-installation",
      "permanent": true
    },
    {
      "source": "/services/paving-and-stepping-stones",
      "destination": "/services/paving",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "^(www\\.)?bastianolandscaping\\.com\\.au$" }],
      "destination": "https://app.bastianolandscaping.com.au/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^(www\\.)?turfandlandscaping\\.com\\.au$" }],
      "destination": "https://bastianolandscaping.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^(www\\.)?bastiano-turf\\.com\\.au$" }],
      "destination": "https://bastianolandscaping.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/((?!api/|assets/|admin/|robots\\.txt|login|invoices|jobs|clients|pricing|settings).*)",
      "has": [{ "type": "host", "value": "^app\\.bastianolandscaping\\.com\\.au$" }],
      "destination": "/jobs",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/integrations/ghl/job-completed",
      "destination": "/api/jobs?ghl=job-completed"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    },
    {
      "source": "/((?:login|invoices|jobs|clients|pricing|settings)(?:/.*)?)",
      "has": [{ "type": "host", "value": "^app\\.bastianolandscaping\\.com\\.au$" }],
      "destination": "/admin"
    }
  ]
}